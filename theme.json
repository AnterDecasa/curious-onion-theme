{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "palette":[
        {
          "color": "#F4F0E6",
          "name": "Paper",
          "slug": "paper"
        },
        {
          "color": "#2D2926",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#68705A",
          "name": "Olive",
          "slug": "olive"
        },
        {
          "color": "#A65F46",
          "name": "Terracotta",
          "slug": "terracotta"
        },
        {
          "color": "#E4D8C3",
          "name": "Parchment",
          "slug": "parchment"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.5rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "2rem"
        },
        {
          "name": "2X Large",
          "slug": "2-x-large",
          "size": "2.5rem"
        } 
      ]
    }
  },
  "styles": {
    "color":  {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    }
  }
}